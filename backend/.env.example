# Copy this file to `.env` in the same directory and fill in real values.
# `.env` itself must NEVER be committed to Git (see .gitignore).

# --- Groq (required for the /query endpoint's answer generation step) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Model id to use for generation. As of writing, Groq recommends
# openai/gpt-oss-120b (their older llama-3.3-70b-versatile was
# deprecated in 2026). Check https://console.groq.com/docs/models
# for the current live list -- these ids do change over time.
GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings (local model, downloaded automatically on first run) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- RAG defaults (can also be overridden per-request from the UI) -----
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=150
DEFAULT_TOP_K=5

# --- Storage paths --------------------------------------------------------
# Relative paths work out of the box for local dev. In production, point
# these at a persistent volume/mount.
UPLOAD_DIR=data/uploads
INDEX_DIR=data/indexes
MAX_FILE_SIZE_MB=20

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins, or "*" for local dev.
CORS_ORIGINS=*
